{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "everruns",
  "version": "0.3.0",
  "description": "Use Everruns from your coding agent: hand tasks to your agents, build and test new ones, debug and evaluate them, ship them to Slack, the web and other channels, and keep an eye on cost and health.",
  "author": {
    "name": "Everruns",
    "email": "support@everruns.com",
    "url": "https://everruns.com"
  },
  "homepage": "https://docs.everruns.com/getting-started/use-in-ai-tools/",
  "repository": "https://github.com/everruns/plugins",
  "license": "MIT",
  "keywords": ["everruns", "agents", "ai-agents", "mcp", "durable-execution", "agent-platform"],
  "extensions": {
    "com.everruns": {
      "mcpServers": {
        "everruns": { "auth": "oauth", "actsAs": "user" }
      }
    }
  }
}
