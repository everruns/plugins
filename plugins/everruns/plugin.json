{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "everruns",
  "version": "0.2.0",
  "description": "Build, run and debug Everruns agents from your coding agent: create agents, run sessions, keep agents as files in your repo, and ship them to Slack, the web and other channels.",
  "author": {
    "name": "Everruns",
    "email": "support@everruns.com",
    "url": "https://everruns.com"
  },
  "homepage": "https://docs.everruns.com/getting-started/use-in-ai-tools/",
  "repository": "https://github.com/everruns/plugins",
  "license": "MIT",
  "keywords": ["everruns", "agents", "ai-agents", "mcp", "durable-execution", "agent-platform"],
  "extensions": {
    "com.everruns": {
      "mcpServers": {
        "everruns": { "auth": "oauth", "actsAs": "user" }
      }
    }
  }
}
